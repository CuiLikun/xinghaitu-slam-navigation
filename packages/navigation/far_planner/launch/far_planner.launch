<launch>
    <arg name="config" default="default"/>
    <arg name="rviz" default="true"/>
    <arg name="config_file" default="$(find far_planner)/config/$(arg config).yaml"/>
    <arg name="odom_topic" default="/Odometry"/>
    
    <arg name="terrain_cloud_topic" default="/terrain_map"/>
    <arg name="terrain_local_topic" default="/terrain_map"/>
    <arg name="scan_cloud_topic" default="/cloud_registered"/>
    

    
    <node pkg="far_planner" type="far_planner" name="far_planner" output="screen">
        <rosparam command="load" file="$(arg config_file)" />
        <remap from="/odom_world" to="$(arg odom_topic)"/> 
        <remap from="/terrain_cloud" to="$(arg terrain_cloud_topic)"/>
        <remap from="/scan_cloud" to="$(arg scan_cloud_topic)"/>
        <remap from="/terrain_local_cloud" to="$(arg terrain_local_topic)"/>
    </node>
    <node if="$(arg rviz)" type="rviz" name="far_rviz" pkg="rviz" args="-d $(find far_planner)/rviz/$(arg config).rviz" respawn="true"/>
    <!-- Launch Graph Manager for saving and loading graph -->
    <include file="$(find graph_decoder)/launch/decoder.launch" />
    <!-- <node pkg="tf" type="static_transform_publisher" name="map_to_camera_init_tf" args="0 0 0 0 0 0 map camera_init 100" /> -->
</launch>
