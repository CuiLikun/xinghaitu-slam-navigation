<launch>
  <!-- Sensor calibration remains the responsibility of the caller. No driver is started here. -->
  <arg name="config_file" default="$(find fast_lio)/config/velodyne.yaml"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="rviz" default="true"/>
  <arg name="pcd_save" default="false"/>
  <arg name="output_directory" default="$(env HOME)/.ros/xinghaitu"/>
  <param name="use_sim_time" value="$(arg use_sim_time)"/>
  <rosparam command="load" file="$(arg config_file)"/>
  <param name="feature_extract_enable" value="false"/>
  <param name="point_filter_num" value="4"/>
  <param name="max_iteration" value="3"/>
  <param name="filter_size_surf" value="0.5"/>
  <param name="filter_size_map" value="0.5"/>
  <param name="cube_side_length" value="1000.0"/>
  <param name="runtime_pos_log_enable" value="false"/>
  <param name="pcd_save/pcd_save_en" value="$(arg pcd_save)"/>
  <param name="output_directory" value="$(arg output_directory)"/>
  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" required="true"/>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="mapping_rviz"
        args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz"/>
</launch>
